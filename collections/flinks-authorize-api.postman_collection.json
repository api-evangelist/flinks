          "id": "e4473625-050e-4b25-b50d-7a26cb0cd23c",
          "name": "Generate a short-lived authorize token.",
          "request": {
            "name": "Generate a short-lived authorize token.",
            "description": {
              "content": "Exchanges your API secret for a 30-minute authorize token that must be supplied in the flinks-auth-key header on all other endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "GenerateAuthorizeToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Assigned instance / environment prefix (e.g. toolbox for sandbox).",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "Your Flinks customer identifier (GUID).",
                  "type": "any",
                  "value": "{{customerId}}",
                  "key": "customerId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "b0d2bafc-f541-4f49-b54e-27a40fd65890",
              "name": "Authorize token generated.",
              "originalRequest": {
                "url": {
                  "path": [
                    "GenerateAuthorizeToken"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Assigned instance / environment prefix (e.g. toolbox for sandbox).",
                      "type": "any",
                      "value": "{{instance}}",
                      "key": "instance"
                    },
                    {
                      "description": "Your Flinks customer identifier (GUID).",
                      "type": "any",
                      "value": "{{customerId}}",
                      "key": "customerId"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
